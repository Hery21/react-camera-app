{
  "name": "storytelling-mirror-plan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify": "npm run format:check && npm run lint && npm run build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:language": "node scripts/check-language.mjs",
    "check:qr": "node scripts/check-qr.mjs",
    "check:exhibit": "node scripts/check-exhibit-lookup.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:validate": "node scripts/check-validate-exhibits.mjs",
    "check:phase3": "node scripts/check-phase3-exit.mjs",
    "check:scanner": "node scripts/check-qr-scanner.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:flow": "node scripts/check-visitor-flow.mjs",
    "check:exhibit-content": "node scripts/check-exhibit-content.mjs",
    "check:exhibit-languages": "node scripts/check-exhibit-languages.mjs",
    "check:content-readiness": "node scripts/check-content-readiness.mjs",
    "check:mvp": "node scripts/check-mvp-integrity.mjs",
    "verify:dev": "npm run format:check && npm run check:mvp && npm run check:flow && npm run check:scanner && npm run check:qr && npm run check:exhibit-languages && npm run check:content-readiness && npm run check:i18n && npm run lint",
    "check:runtime-cleanup": "node scripts/check-runtime-cleanup.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "check:article-pagination": "node scripts/check-article-pagination.mjs",
    "check:article-controls": "node scripts/check-article-controls.mjs",
    "check:article-navigation": "node scripts/check-article-navigation.mjs",
    "check:article-viewport": "node scripts/check-article-viewport.mjs",
    "check:article-control-treatment": "node scripts/check-article-control-treatment.mjs",
    "check:reader-font-controls": "node scripts/check-reader-font-controls.mjs",
    "check:sentence-pagination": "node scripts/check-sentence-pagination.mjs",
    "check:sentence-packing": "node scripts/check-sentence-packing.mjs",
    "check:article-layout": "node scripts/check-article-layout.mjs",
    "check:assets": "node scripts/check-decorative-assets.mjs",
    "check:scan-progress": "node scripts/check-scan-progress.mjs",
    "check:progress-layout": "node scripts/check-progress-layout.mjs",
    "check:responsive": "node scripts/check-responsive-baseline.mjs",
    "check:scanner-stability": "node scripts/check-scanner-stability.mjs",
    "check:vite-assets": "node scripts/check-vite-assets.mjs",
    "check:quiz": "node scripts/check-quiz.mjs"
